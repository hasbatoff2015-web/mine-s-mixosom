# Installed to /etc/frontier-cubes/anarchy.env
# WORLD_PATH is the parent directory. This process stores its world in
# /var/lib/frontier-cubes/worlds/anarchy ($WORLD_PATH/$WORLD).
# Do not add passwords or tokens here and then commit the server copy.
HOST=0.0.0.0
PORT=2567
SERVER_MODE=anarchy
WORLD=anarchy
WORLD_PATH=/var/lib/frontier-cubes/worlds
TICK_RATE=20
CHUNK_VIEW_RADIUS=4
MAX_PLAYERS=300
PERSIST_INTERVAL_MS=30000
PLUGIN_DIR=/var/lib/frontier-cubes/plugins
