# Installed to /etc/frontier-cubes/survival.env
# World directory: /var/lib/frontier-cubes/worlds/survival
HOST=0.0.0.0
PORT=2568
SERVER_MODE=survival
WORLD=survival
WORLD_PATH=/var/lib/frontier-cubes/worlds
TICK_RATE=20
CHUNK_VIEW_RADIUS=4
MAX_PLAYERS=300
PERSIST_INTERVAL_MS=30000
PLUGIN_DIR=/var/lib/frontier-cubes/plugins
# Optional PostgreSQL. Leave these commented to keep the filesystem server.
# A real URL belongs in /etc, never in git. See docs/POSTGRESQL.md.
# FC_DATABASE_URL=
# FC_DEPLOYMENT_ID=
# FC_DB_POOL_MAX=4
# Exactly two equal admin ids. Not operator nicknames. Leave commented to disable admin writes.
# FC_ADMIN_IDS=admin-owner,admin-colleague
# Private admin HTTP. Leave commented to keep the listener off.
# It binds 127.0.0.1 only. Do not publish the port. See docs/ADMIN.md.
# FC_ADMIN_PORT=
# FC_ADMIN_AUTH_HASHES=
