# Survival and Peaceful have no confirmed public WSS route yet. Do not invent one.
# When nginx exposes them, set VITE_SURVIVAL_URL and VITE_PEACEFUL_URL to those wss origins.
VITE_ANARCHY_URL=wss://megacraft.agariobrainrot.ru
